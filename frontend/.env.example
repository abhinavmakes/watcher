# Base path or origin of the Watcher read API. Relative ("/api") in production, where the
# API shares the site's domain; absolute for local dev against `uvicorn app.main:app`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Render typed fixtures instead of calling the API. Opt-in: anything but "true" uses the
# live API. Handy for working on the UI without a backend or database.
NEXT_PUBLIC_USE_MOCKS=false

# Dev-only: with mocks on, "true" makes the feed throw a simulated 429 so you can
# preview the rate-limit toast without a live API. Leave off in normal use.
NEXT_PUBLIC_SIMULATE_429=false
