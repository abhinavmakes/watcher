# App
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Per-IP rate limit on the public read API (slowapi format, e.g. "60/minute", "100/hour").
RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true
# Number of proxies between the client and this app. 0 = nothing in front (X-Forwarded-For
# is ignored, safe default). Set to 1 behind a single ALB/CDN.
TRUSTED_PROXY_HOPS=0

# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Pipeline LLMs
CLAUDE_API_KEY=
CLASSIFIER_MODEL=anthropic:claude-haiku-4-5-20251001
SYNTHESIS_MODEL=anthropic:claude-sonnet-5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_CONTENT_CHARS=8000
EMBEDDING_BATCH_SIZE=128

# Worker / clustering
PIPELINE_INTERVAL_MINUTES=30
HN_FETCH_LIMIT=30
RSS_FETCH_LIMIT=50
# Comma-separated. Every feed here was measured through the production parse path
# (_extract_body + clean_html) before being added: median body length and the fraction
# of entries over 2500 chars. Feeds are kept/dropped on measured yield, never on topical
# fit — see DECISIONS.md. Perfectly on-topic feeds get rejected for shipping summaries only.
RSS_FEED_URLS=https://simonwillison.net/atom/everything/,https://magazine.sebastianraschka.com/feed,https://lilianweng.github.io/index.xml,https://bair.berkeley.edu/blog/feed.xml,https://newsletter.pragmaticengineer.com/feed,https://aws.amazon.com/blogs/machine-learning/feed/,https://aws.amazon.com/blogs/architecture/feed/,https://engineering.fb.com/feed/,http://feeds.feedburner.com/blogspot/gJZg,https://jvns.ca/atom.xml,https://github.blog/feed/,https://www.latent.space/feed,https://huyenchip.com/feed.xml,https://www.interconnects.ai/feed,https://www.answer.ai/index.xml,https://blog.cloudflare.com/rss/,https://netflixtechblog.com/feed,https://hamel.dev/index.xml
CLUSTER_EXISTING_SIMILARITY_THRESHOLD=0.85
CLUSTER_NEW_SIMILARITY_THRESHOLD=0.83
MOMENTUM_STALE_HOURS=48
MOMENTUM_HALF_LIFE_HOURS=24
HIGH_SIGNAL_SOURCE_DOMAINS=openai.com,anthropic.com,ai.googleblog.com,huggingface.co,fastapi.tiangolo.com
