# Copy to .env for local runs. Only secrets and the feed list belong here.
# Every other setting has a default in backend/app/core/config.py. Set one here only if it
# must differ locally: an env value silently shadows the code default, which is how a stale
# SYNTHESIS_MODEL once 404'd every synthesis call (DECISIONS.md, 2026-06-21).

SUPABASE_URL=
SUPABASE_SECRET_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# Comma-separated. Mirrors the RSS_FEED_URLS repository variable in GitHub Actions.
RSS_FEED_URLS=https://simonwillison.net/atom/everything/,https://magazine.sebastianraschka.com/feed,https://lilianweng.github.io/index.xml,https://bair.berkeley.edu/blog/feed.xml,https://newsletter.pragmaticengineer.com/feed,https://aws.amazon.com/blogs/machine-learning/feed/,https://aws.amazon.com/blogs/architecture/feed/,https://engineering.fb.com/feed/,http://feeds.feedburner.com/blogspot/gJZg,https://jvns.ca/atom.xml,https://github.blog/feed/,https://www.latent.space/feed,https://huyenchip.com/feed.xml,https://www.interconnects.ai/feed,https://www.answer.ai/index.xml,https://blog.cloudflare.com/rss/,https://netflixtechblog.com/feed,https://hamel.dev/index.xml,https://news.google.com/rss/search?q=artificial+intelligence&hl=en-US&gl=US&ceid=US:en,https://techcrunch.com/category/artificial-intelligence/feed/,https://arstechnica.com/ai/feed/,https://the-decoder.com/feed/
