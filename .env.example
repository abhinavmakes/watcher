# App
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Per-IP rate limit on the public read API (slowapi format, e.g. "60/minute", "100/hour").
RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true

# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Pipeline LLMs
CLAUDE_API_KEY=
CLASSIFIER_MODEL=anthropic:claude-haiku-4-5-20251001
SYNTHESIS_MODEL=google-gla:gemini-2.5-flash
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_CONTENT_CHARS=2000
EMBEDDING_BATCH_SIZE=128

# Security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Worker / clustering
PIPELINE_INTERVAL_MINUTES=30
HN_FETCH_LIMIT=30
RSS_FETCH_LIMIT=50
RSS_FEED_URLS=
CLUSTER_EXISTING_SIMILARITY_THRESHOLD=0.85
CLUSTER_NEW_SIMILARITY_THRESHOLD=0.83
MOMENTUM_STALE_HOURS=48
MOMENTUM_HALF_LIFE_HOURS=24
HIGH_SIGNAL_SOURCE_DOMAINS=openai.com,anthropic.com,ai.googleblog.com,huggingface.co,fastapi.tiangolo.com
