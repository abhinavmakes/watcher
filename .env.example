# App
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Pipeline LLMs
GOOGLE_API_KEY=
CLASSIFIER_MODEL=google-gla:gemini-2.5-flash-lite
SYNTHESIS_MODEL=google-gla:gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-005

# Security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Worker / clustering
PIPELINE_INTERVAL_MINUTES=30
CLUSTER_EXISTING_SIMILARITY_THRESHOLD=0.85
CLUSTER_NEW_SIMILARITY_THRESHOLD=0.83
MOMENTUM_STALE_HOURS=48
HIGH_SIGNAL_SOURCE_DOMAINS=openai.com,anthropic.com,ai.googleblog.com,huggingface.co,fastapi.tiangolo.com
